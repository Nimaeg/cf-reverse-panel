{
  "name": "cf-reverse-iran",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env agent/main.mjs",
    "test": "node --test tests/*.test.mjs",
    "worker:check": "wrangler deploy --dry-run --config worker/wrangler.toml --outdir ../build",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "config:xray": "node scripts/xray-config.mjs"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  }
}
